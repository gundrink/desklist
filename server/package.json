{
  "name": "@desklist/server",
  "version": "0.6.13",
  "private": true,
  "type": "module",
  "description": "Desklist sync server (REST + WebSocket). The only process that touches PostgreSQL.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "migrate:prod": "node dist/migrate.js",
    "seed:prod": "node dist/seed.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bootstrap-admin": "tsx src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "google-auth-library": "^9.15.1",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
