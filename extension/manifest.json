{
  "manifest_version": 3,
  "name": "Desklist",
  "version": "0.6.13",
  "description": "Team project checklists in a Chrome side panel. Uses your Desklist server.",
  "action": {
    "default_title": "Open Desklist",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "sidePanel", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://server-production-46b2.up.railway.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
