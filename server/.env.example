# Copy to server/.env and fill in. NEVER commit server/.env. See ../ENV.md for every variable.
# --- required ---
# Neon / PostgreSQL connection string (Neon host => @neondatabase/serverless over 443; other hosts => pg). SECRET.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
# 32+ random chars. Encrypts secret master fields at rest. Must stay identical across deploys. SECRET.
APP_ENCRYPTION_KEY=replace-with-a-long-random-string
# --- optional ---
# HTTP port (Railway sets this automatically)
PORT=8787
# Public URL of this server (informational; the desktop app uses DESKLIST_SERVER_URL)
PUBLIC_SERVER_URL=https://your-service.up.railway.app
# Max failed sign-in attempts per IP per 15 minutes
SIGNIN_RATE_LIMIT=10
# CoinGecko key for live prices (public API works without it). SECRET if set.
COINGECKO_API_KEY=
# "demo" (default, public host) or "pro" (pro-api host)
COINGECKO_API_PLAN=demo
# Price cache TTL in seconds (default 300)
PRICE_CACHE_SECONDS=300
# Reserved for future on-chain checks; not used by v5.
SOLANA_RPC_URL=
# "http" to use the Neon HTTP driver instead of the WebSocket pool (no real transactions)
DESKLIST_DB_DRIVER=
